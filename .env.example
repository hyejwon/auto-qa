# ── qa-auto 단일 노드 설정 ──────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (run_app 실행 시 자동 복사됨)

# 사내 LLM Gateway (Vision/플래너용) — 필수
LLM_GATEWAY_URL=https://llm-gateway.111percent.net/llm/google
LLM_GATEWAY_TOKEN=발급받은_토큰값

# 테스트할 디바이스/에뮬레이터 (LDPlayer 기본: 127.0.0.1:5555)
# 실디바이스는 adb devices 에 나오는 ID. 비워두면 첫 번째 연결 디바이스 사용.
ADB_DEVICE=127.0.0.1:5555

# (선택) Google 계정 연동 precondition 용
# google_id=
# google_pw=
