# ── auto-qa 단일 노드 로컬 실행 설정 ─────────────────
# 이 파일을 .env 로 복사한 뒤 로컬 환경에 맞게 값을 채우세요.

# 사내 LLM Gateway (Vision/플래너/evaluator용)
LLM_GATEWAY_URL=https://llm-gateway.111percent.net/llm/google
LLM_GATEWAY_TOKEN=

# 테스트할 디바이스/에뮬레이터.
# 중앙 서버 모드에서는 비워둡니다 (웹 UI에서 디바이스 선택).
# 로컬 단일 디바이스 모드에서만 지정: LDPlayer = 127.0.0.1:5555, USB 실기기 = R39N403X6VH
ADB_DEVICE=

# adb가 PATH에 없을 때만 지정합니다.
ADB_PATH=

# 기기에 보안 잠금(PIN)이 설정된 경우에만 지정 — 화면 잠금 자동 해제에 사용.
# 평문 저장이므로 QA 전용 기기의 임시 PIN만 사용할 것.
# 가능하면 PIN 자체를 없애는 것을 권장: adb shell locksettings clear --old <PIN>
ADB_UNLOCK_PIN=

# Unity in-app API / tutorial pass용.
# 비워두면 디바이스별로 포트를 자동 할당합니다 (다중 디바이스 서버는 반드시 비워둘 것).
UNITY_API_URL=

# Google 계정 연동 테스트를 쓸 때만 채웁니다.
GOOGLE_TEST_ID=
GOOGLE_TEST_PASSWORD=
