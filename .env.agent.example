# ── qa-auto Agent (각 PC exe용) ──────────────────────
# 오케스트레이터 서버 주소 (비워두면 단독 실행 모드)
ORCHESTRATOR_URL=http://사내서버IP:8000

# 이 PC의 식별 이름
AGENT_NAME=테스터이름-PC

# 에이전트 로컬 포트 (기본 8000)
AGENT_PORT=8000

# ADB 디바이스 (LDPlayer 기본: 127.0.0.1:5555)
ADB_DEVICE=127.0.0.1:5555

# LLM Gateway
LLM_GATEWAY_URL=https://llm-gateway.111percent.net/llm/google
LLM_GATEWAY_TOKEN=발급받은_토큰값
